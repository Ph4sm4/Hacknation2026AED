# Copy to .env and fill in (used by docker-compose.prod.yml). All keys are optional except DOMAIN for HTTPS.

# Host port for Caddy (default 80)
HTTP_PORT=

# Public origin when running behind a tunnel, e.g. https://xyz.ngrok-free.app (empty = request host)
PUBLIC_BASE_URL=

# Own domain (deploy/docker-compose.https.yml) without https://, e.g. gdzieaed.pl or gdzieaed.duckdns.org
DOMAIN=

# Random string for signing logins: openssl rand -hex 32
# (if empty, the app generates one and keeps it next to the database)
AED_SECRET=

# Comma-separated e-mails of accounts that can moderate reports
AED_MODERATORS=

# Optional: search console verification tokens (baked into the frontend at build time)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
